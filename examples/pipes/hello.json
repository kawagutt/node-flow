{
  "kind": "pipe",
  "version": "1.7",
  "pipe": {
    "outputs": {
      "greeting": "demo.message"
    }
  },
  "nodes": [
    {
      "id": "demo",
      "path": "examples/nodes/hello_demo/node.json",
      "inputs": {
        "tick": "input.incoming"
      },
      "config": {
        "message": "Hello from NodeFlow!"
      }
    }
  ]
}
